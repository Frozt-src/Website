{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monolith-site",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "mnlith.dev", "custom_domain": true }]
}

{
  "name": "monolith-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm test && npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "verify:site": "node scripts/verify-site.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p api/tsconfig.json",
    "test": "node --test api/tests/*.test.ts",
    "test:watch": "node --test --watch api/tests/*.test.ts",
    "api:dev": "wrangler dev --config api/wrangler.jsonc",
    "api:deploy": "npm test && wrangler deploy --config api/wrangler.jsonc",
    "api:check": "wrangler deploy --dry-run --config api/wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "motion": "13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260917.1",
    "@types/node": "^26.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.133.0"
  }
}
